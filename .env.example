# Local credentials template — copy to `.env` and fill in real values.
# `.env` is in .gitignore; never commit it.

# Compute VPS — used for offline backtest sweeps (Linux, optional)
COMPUTE_VPS_HOST=your.compute.host.example
COMPUTE_VPS_PORT=22
COMPUTE_VPS_USER=root
COMPUTE_VPS_PASSWORD=changeme
COMPUTE_VPS_REPO=/root/gold-quant-research

# MT4 production VPS — runs gold_runner.py + MT4 EAs (Windows)
MT4_VPS_HOST=your.mt4.host.example
MT4_VPS_PORT=22
MT4_VPS_USER=administrator
MT4_VPS_PASSWORD=changeme
MT4_VPS_LOG=C:\Users\administrator\gold-quant-trading\logs\gold_runner.log

# Telegram bot used by scripts/vps_watchdog.py for outage alerts.
# IMPORTANT: if you migrated from the legacy hardcoded token,
# rotate the bot token via @BotFather (/revoke -> /token) since the
# old one is in git history.
TELEGRAM_BOT_TOKEN=changeme:BotFatherToken
TELEGRAM_CHAT_ID=000000000
